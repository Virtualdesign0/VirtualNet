        "Runtime": {
          "$path": "src/VNet/Runtime"
        },

        "Schema": {
          "$path": "src/VNet/Schema"
        },

        "Signals": {
          "$path": "src/VNet/Signals"
        },

        "Wire": {
          "$path": "src/VNet/Wire"
        },

        "Benchmarks": {
          "$className": "Folder",

          "FrameBenchConfig": {
            "$path": "benchmarks/FrameBenchConfig.luau"
          },

          "FramePayloads": {
            "$path": "benchmarks/FramePayloads.luau"
          },

          "FrameByteCounter": {
