      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",

      "FrameServerBenchmark": {
        "$path": "benchmarks/FrameServerBenchmark.server.luau"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",

        "FrameClientBenchmark": {
          "$path": "benchmarks/FrameClientBenchmark.client.luau"
        }
